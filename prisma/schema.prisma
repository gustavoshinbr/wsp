generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  CANCELED
  INACTIVE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  CANCELLED
  PAID
}

enum AppointmentStatus {
  SCHEDULED
  FINISHED
  CANCELLED
}

enum ItemType {
  PRODUCT
  SERVICE
  MANUAL
}

enum SalePaymentStatus {
  PAID
  CREDIT_OPEN
  CREDIT_PAID
  CANCELED
}

enum FiscalDocumentType {
  NFCE
  NFE
  NFSE
}

enum FiscalDocumentStatus {
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
  ERROR
}

model User {
  id                   String        @id @default(cuid())
  name                 String
  email                String        @unique
  phone                String?
  passwordHash         String
  role                 UserRole      @default(OWNER)
  isActive             Boolean       @default(true)
  isMechanic           Boolean       @default(false)
  specialty            String?
  commissionPercent    Decimal?      @db.Decimal(5, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  workspaceId          String
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mechanicSales        Sale[]        @relation("SaleMechanic")
  mechanicAppointments Appointment[] @relation("AppointmentMechanic")

  @@index([workspaceId])
}

model Workspace {
  id                           String             @id @default(cuid())
  workshopName                 String
  ownerName                    String
  document                     String             @unique
  phone                        String?
  email                        String             @unique
  trialStartAt                 DateTime
  trialEndsAt                  DateTime
  subscriptionStatus           SubscriptionStatus @default(TRIAL)
  asaasCustomerId              String?
  asaasSubscriptionId          String?
  subscriptionActivatedAt      DateTime?
  subscriptionCurrentPeriodEnd DateTime?
  paymentStatus                String?
  lastPaymentEvent             String?
  stockViewMode                String             @default("completo")
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  users                        User[]
  clients                      Client[]
  motorcycles                  Motorcycle[]
  products                     Product[]
  services                     Service[]
  quotes                       Quote[]
  appointments                 Appointment[]
  sales                        Sale[]
  fiscalConfig                 FiscalConfig?
  fiscalDocuments              FiscalDocument[]
}

model Client {
  id           String       @id @default(cuid())
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  address      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  motorcycles  Motorcycle[]
  quotes       Quote[]
  appointments Appointment[]
  sales        Sale[]

  @@index([workspaceId])
}

model Motorcycle {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plate        String
  model        String?
  brand        String?
  year         String?
  color        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  quotes       Quote[]
  appointments Appointment[]
  sales        Sale[]

  @@index([workspaceId])
  @@index([clientId])
}

model Product {
  id           String            @id @default(cuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  buyPrice     Decimal           @db.Decimal(10, 2)
  sellPrice    Decimal           @db.Decimal(10, 2)
  quantity     Int
  mainImageUrl String?
  barcode      String?
  qrCode       String?
  ncm          String?
  cfop         String?
  csosn        String?
  fiscalUnit   String?           @default("UN")
  fiscalOrigin String?           @default("0")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  images       ProductImage[]
  quoteItems   QuoteItem[]
  appointmentItems AppointmentItem[]
  saleItems    SaleItem[]

  @@index([workspaceId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Service {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  price            Decimal           @db.Decimal(10, 2)
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  quoteItems       QuoteItem[]
  appointmentItems AppointmentItem[]
  saleItems        SaleItem[]

  @@index([workspaceId])
}

model Quote {
  id           String       @id @default(cuid())
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  motorcycleId String?
  motorcycle   Motorcycle?  @relation(fields: [motorcycleId], references: [id])
  status       QuoteStatus  @default(DRAFT)
  manualValue  Decimal?     @db.Decimal(10, 2)
  total        Decimal      @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        QuoteItem[]
  sales        Sale[]

  @@index([workspaceId])
  @@index([clientId])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  type        ItemType
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)

  @@index([quoteId])
  @@index([productId])
  @@index([serviceId])
}

model Appointment {
  id           String            @id @default(cuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id])
  motorcycleId String?
  motorcycle   Motorcycle?       @relation(fields: [motorcycleId], references: [id])
  mechanicId   String?
  mechanic     User?             @relation("AppointmentMechanic", fields: [mechanicId], references: [id])
  date         DateTime
  status       AppointmentStatus @default(SCHEDULED)
  notes        String?
  total        Decimal?          @db.Decimal(10, 2)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  items        AppointmentItem[]
  sales        Sale[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([mechanicId])
}

model AppointmentItem {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  serviceId     String?
  service       Service?    @relation(fields: [serviceId], references: [id])
  type          ItemType
  description   String
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)

  @@index([appointmentId])
  @@index([productId])
  @@index([serviceId])
}

model Sale {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id])
  motorcycleId  String?
  motorcycle    Motorcycle?  @relation(fields: [motorcycleId], references: [id])
  mechanicId    String?
  mechanic      User?        @relation("SaleMechanic", fields: [mechanicId], references: [id])
  quoteId       String?
  quote         Quote?       @relation(fields: [quoteId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  total         Decimal      @db.Decimal(10, 2)
  paymentMethod String?
  paymentStatus SalePaymentStatus @default(PAID)
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  items         SaleItem[]
  fiscalDocuments FiscalDocument[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([mechanicId])
  @@index([quoteId])
  @@index([appointmentId])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  type        ItemType @default(MANUAL)
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)

  @@index([saleId])
  @@index([productId])
  @@index([serviceId])
}

model FiscalConfig {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyName           String
  cnpj                  String
  stateRegistration     String?
  municipalRegistration String?
  address               String?
  phone                 String?
  email                 String?
  provider              String    @default("FOCUS_NFE")
  environment           String    @default("homologacao")
  focusHomologationTokenEncrypted String?
  focusHomologationTokenLastFour  String?
  focusProductionTokenEncrypted   String?
  focusProductionTokenLastFour    String?
  defaultNcm            String?
  defaultCfop           String    @default("5102")
  defaultCsosn          String    @default("102")
  defaultPisCst         String    @default("49")
  defaultCofinsCst      String    @default("49")
  defaultUnit           String    @default("UN")
  defaultOrigin         String    @default("0")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model FiscalDocument {
  id             String               @id @default(cuid())
  workspaceId    String
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  saleId         String?
  sale           Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  type           FiscalDocumentType
  status         FiscalDocumentStatus @default(PROCESSING)
  provider       String
  environment    String
  reference      String               @unique
  number         String?
  series         String?
  accessKey      String?
  protocol       String?
  statusCode     String?
  message        String?
  danfeUrl       String?
  xmlUrl         String?
  qrCodeUrl      String?
  payload        Json?
  response       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([workspaceId])
  @@index([saleId])
  @@index([status])
}
